{
  "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "para_target_env": { "value": "-Azure.Environment.Name-" },
    "para_application_name": { "value": "-Application-" },

    "para_kvSecretsObject": {
      "value": {
        "secrets": [
          {
            "secretName": "QueueConnectionString",
            "secretValue": "-HubStorageConnection-"
          },
          {
            "secretName": "InboundQueueName",
            "secretValue": "-InboundQueueName-"
          },
          {
            "secretName": "UseDevelopmentCallbackQueues",
            "secretValue": "-UseDevelopmentCallbackQueues-"
          },
          {
            "secretName": "CallbackQueueName",
            "secretValue": "-CallbackQueueName-"
          },
          {
            "secretName": "ContainerName",
            "secretValue": "-ContainerName-"
          },
          {
            "secretName": "PollingTableName",
            "secretValue": "-PollingTableName-"
          },
          {
            "secretName": "ApiUrl",
            "secretValue": "-ApiUrl-"
          },
          {
            "secretName": "ApiUserName",
            "secretValue": "-ApiUserName-"
          },
          {
            "secretName": "ApiPassword",
            "secretValue": "-ApiPassword-"
          },
          {
            "secretName": "PollingFuncCron",
            "secretValue": "-PollingFuncCron-"
          }
        ]
      }
    }
  }
}
