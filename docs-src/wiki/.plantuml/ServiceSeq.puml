@startuml 

Actor Negotiator as neg
Actor Hub as App
database Hubdb as hubdb
queue ServiceBus

participant Service
participant DocMgmt
database  DataStore
participant LR as svc


== Send Request == 
neg -> App ++ #gold : Find Title 
        App -> ServiceBus ++ #gold : Send Address details
                ServiceBus -> Service  ++ #gold
                        Service -> DataStore  : Save Message
                        activate Service #DarkSalmon
                                Service -> svc  ++ #gold : Find Title No
                                svc --> Service --:
                        deactivate Service
                        Service -> svc  ++ #gold : Get Title Documents
                        svc --> Service --:
                        Service --> DocMgmt ++ #gold : Save Documents
                        DocMgmt --> Service  --
                        Service -> DataStore  : Update Message        
                Service --> ServiceBus --:
        ServiceBus --> App --: Response
App --> neg --: Notify   


== Error Handling ==
group svc System Error 5xx
        svc --> Service : HTTP Status 5xx
        Service -> svc : Retry - Several Times
        Service -> ServiceBus : Publish request onto Inbound.

end
group svc Data Error 4xx
        svc --> Service : HTTP Status 4xx
        Service --> ServiceBus
        ServiceBus --> App
        App --> neg : Notify
end    


== Ad Hoc HTTP ==
App -> Service ++ #gold
        Service -> DataStore ++ #gold: Get Message
        DataStore --> Service --
        Service -> DocMgmt ++ #gold: Get Documents
        DocMgmt --> Service  --
        Service --> App --
@enduml